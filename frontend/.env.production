# Tarazu — AI Audit Assistant, production frontend environment.
#
# Loaded by `next build` (production) only; `next dev` ignores this file and
# uses .env.local instead. On a hosting platform, a variable set in the
# dashboard takes precedence over this file.
#
# NOTE: if you run `next build` on a machine that has frontend/.env.local,
# that file outranks this one — build with the variable set in the shell, or
# set it in the host's dashboard, to be certain the live URL wins.
NEXT_PUBLIC_TARAZU_API_URL=https://tarazu-mv6t.onrender.com
