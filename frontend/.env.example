# Tarazu — AI Audit Assistant, frontend environment.
#
# Leave NEXT_PUBLIC_TARAZU_API_URL unset (or empty) and the app runs entirely
# on the fixture data in src/lib/fixtures/ — no backend needed, and the login
# screen accepts the demo credentials it pre-fills. Set it to the running
# FastAPI app and every screen switches to the real API: sign in (or sign up
# a firm) on the login screen and the session token is used everywhere.
NEXT_PUBLIC_TARAZU_API_URL=

# Optional fallback bearer token, used only when nobody is signed in through
# the UI (for example, driving the app from a script). The login screen is the
# normal path. Never put a secret that is not NEXT_PUBLIC_* here.
NEXT_PUBLIC_TARAZU_DEMO_TOKEN=
