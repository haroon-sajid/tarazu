# Tarazu — AI Audit Assistant, frontend environment.
#
# Leave NEXT_PUBLIC_TARAZU_API_URL unset (or empty) and the app runs entirely
# on the fixture data in src/lib/fixtures/ — no backend needed. Set it to the
# running FastAPI app and every screen switches to the real API. This is the
# one-line change the build plan promises.
NEXT_PUBLIC_TARAZU_API_URL=

# A bearer token for the live backend (the seeded demo user's login token).
# Fixture mode ignores it. Never put a secret that is not NEXT_PUBLIC_* here.
NEXT_PUBLIC_TARAZU_DEMO_TOKEN=
