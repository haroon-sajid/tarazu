# Tarazu — AI Audit Assistant: environment variables.
# Variable names only. Copy this file to .env and fill in values locally.
# Never commit .env. The backend is one app; per-module prefixes are kept so
# configuration stays extractable per module.

# Shared / Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Frontend (Next.js)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_BACKEND_URL=

# Backend (app-level, core/)
BACKEND_PORT=
BACKEND_JWT_AUDIENCE=

# Backend module: extraction
EXTRACTION_QWEN_API_KEY=
EXTRACTION_QWEN_API_BASE_URL=
EXTRACTION_QWEN_VL_MODEL=
EXTRACTION_SECOND_OPINION_MODEL=
EXTRACTION_CONFIDENCE_THRESHOLD=

# Backend module: matching
# Deterministic; no external services. Module settings to be defined.

# Backend module: rules
RULES_NEAR_LIMIT_THRESHOLD=

# Backend module: assistant
ASSISTANT_QWEN_API_KEY=
ASSISTANT_QWEN_MODEL=

# Backend module: reports
# Deterministic templating. Module settings to be defined.
