# Tarazu — AI Audit Assistant: environment variables.
# Variable names only. Copy this file to .env and fill in values locally.
# Never commit .env. The backend is one app; per-module prefixes are kept so
# configuration stays extractable per module.
#
# `.env` in the repo root is read on import by backend/app/core/config.py and
# never overrides a variable already exported, so a real environment variable
# always wins. Set TARAZU_DOTENV=0 to ignore the file — the test suite and
# scripts/demo_tenant_isolation.py both do, so neither can reach a real project.
# TARAZU_ENV_FILE points at a different file (a mounted secret, for instance).
TARAZU_DOTENV=
TARAZU_ENV_FILE=

# Shared / Supabase
# SUPABASE_URL selects the backing store. Set it and the app uses Supabase
# (Postgres, Storage, Auth). Leave it unset and the app runs entirely locally
# on SQLite and the filesystem, so the pipeline can be run and demoed before
# the Supabase project exists. The code either side of the store is identical.
# Format: https://<project-ref>.supabase.co
SUPABASE_URL=
# Derived from SUPABASE_URL when unset. The id `supabase link --project-ref`
# wants, and the one in every dashboard URL.
SUPABASE_PROJECT_REF=
SUPABASE_REGION=
# The browser-safe key, sent as the `apikey` header when signing in. Either the
# legacy anon JWT (eyJ...) or the newer publishable key (sb_publishable_...).
SUPABASE_ANON_KEY=
# The modern equivalent of the anon key, if your project issues both. Same
# standing: safe in the browser, still subject to row-level security.
SUPABASE_PUBLISHABLE_KEY=
# SECRET. The backend's own credential for PostgREST and Storage: it bypasses
# row-level security, so it must never reach the browser or a NEXT_PUBLIC_* var.
# Either the legacy service_role JWT (eyJ...) or the newer sb_secret_... key.
SUPABASE_SERVICE_ROLE_KEY=
# Create this bucket as PRIVATE. Client documents must never be world-readable.
SUPABASE_STORAGE_BUCKET=tarazu-documents
# Project Settings -> API -> JWT Settings. Used to verify access tokens, so the
# audit trail carries a user id the client cannot forge.
#
# This is the symmetric HS256 secret. New Supabase projects instead sign with
# asymmetric keys (ES256) published at /auth/v1/.well-known/jwks.json, which the
# backend fetches and caches on its own — nothing to configure for those. Set
# this anyway: it is what a legacy HS256 project needs, and it is ignored on a
# project that signs asymmetrically.
SUPABASE_JWT_SECRET=

# Direct Postgres connection, from Project Settings -> Database. SECRET.
# The backend NEVER uses this: it reaches Postgres through PostgREST with the
# service-role key. This is for schema work only, and is read by exactly one
# thing — scripts/apply_supabase_schema.py, which applies the files in
# infra/supabase/ in order.
#   postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=

# Local store, used only when SUPABASE_URL is unset. Defaults shown.
LOCAL_DATABASE_PATH=.local/tarazu.db
LOCAL_STORAGE_PATH=.local/documents

# Auth. Everybody signs themselves up at POST /v1/auth/signup, which also
# creates the organization they own. The demo auditor predates that flow and is
# seeded instead: create the user with `python scripts/seed_demo_user.py`, then
# paste the UUID it prints into AUTH_DEV_USER_ID so the local store agrees on
# the same identity. That script also puts them in DEFAULT_ORG_ID.
DEMO_USER_EMAIL=auditor@tarazu.local
DEMO_USER_PASSWORD=
AUTH_DEV_USER_ID=00000000-0000-4000-8000-000000000001
# Serve requests with no token as the development user. Local development only.
# MUST be false anywhere this is deployed: it turns off authentication.
AUTH_ALLOW_DEV_USER=false
# Signs the tokens POST /v1/auth/login issues when SUPABASE_URL is unset, so the
# local store can be its own identity provider. Ignored entirely with Supabase
# configured, where GoTrue issues tokens and SUPABASE_JWT_SECRET verifies them.
# Set a real random value if a local instance is reachable by anyone else.
LOCAL_JWT_SECRET=
# Lifetime of those local tokens, in seconds. Default: 3600
LOCAL_TOKEN_TTL_SECONDS=

# Tenancy: a tenant is one accounting firm.
# The organization the seeded demo auditor belongs to, and the one that
# infra/supabase/0002-organizations.sql backfills pre-tenancy rows into.
# Changing it after that migration has run will orphan those rows.
DEFAULT_ORG_ID=00000000-0000-4000-8000-0000000000d0
DEFAULT_ORG_NAME=Tarazu Demo Firm

# Frontend (Next.js)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_BACKEND_URL=

# Backend (app-level, core/)
BACKEND_PORT=8000
BACKEND_JWT_AUDIENCE=authenticated
# Comma-separated. Add the deployed frontend origin before the demo.
BACKEND_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# When true, extraction replays cached results from sample-data/fixtures/
# instead of calling Qwen: same schemas, same downstream code path, no network.
# Arm this for the live demo. Leave it off when recording the video.
DEMO_MODE=

# Backend module: extraction
# The API key. DASHSCOPE_API_KEY is the name Alibaba's own tooling uses, so it
# is the one you probably already have exported; EXTRACTION_QWEN_API_KEY is this
# repo's per-module convention and wins if both are set. Set exactly one.
DASHSCOPE_API_KEY=
EXTRACTION_QWEN_API_KEY=
# Model Studio, OpenAI-compatible mode. Default is the international host:
#   https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# For a Beijing-registered account use:
#   https://dashscope.aliyuncs.com/compatible-mode/v1
EXTRACTION_QWEN_API_BASE_URL=
# Default: qwen-vl-max
EXTRACTION_QWEN_VL_MODEL=
# Defaults to the VL model above.
EXTRACTION_SECOND_OPINION_MODEL=
# Verify any field at or below this confidence: low (default) or medium.
# Verification doubles the token cost of a page, so raise it deliberately.
EXTRACTION_CONFIDENCE_THRESHOLD=
# PDF render resolution for the vision model. Default: 200
EXTRACTION_PAGE_IMAGE_DPI=
# Default: 90 seconds. Vision calls on a dense page are slow.
EXTRACTION_REQUEST_TIMEOUT_SECONDS=
# Attempts per request, including the first. Default: 3
EXTRACTION_MAX_ATTEMPTS=
# Seconds before the first retry; doubles each attempt. Default: 1.0
EXTRACTION_BACKOFF_BASE_SECONDS=

# Backend module: matching
# Deterministic; no external services. Module settings to be defined.

# Backend module: rules
RULES_NEAR_LIMIT_THRESHOLD=

# Backend module: assistant
ASSISTANT_QWEN_API_KEY=
ASSISTANT_QWEN_MODEL=

# Backend module: reports
# Deterministic templating. Module settings to be defined.
