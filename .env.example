# Tarazu — AI Audit Assistant — environment variables
# Variable NAMES only. Copy to .env and fill values locally. Never commit .env.
# One backend app; per-module prefixes kept so config stays extractable per module.

# ---------- Shared / Supabase ----------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# ---------- frontend (Next.js) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_BACKEND_URL=

# ---------- backend (app-level, core/) ----------
BACKEND_PORT=
BACKEND_JWT_AUDIENCE=

# ---------- backend module: extraction ----------
EXTRACTION_QWEN_API_KEY=
EXTRACTION_QWEN_API_BASE_URL=
EXTRACTION_QWEN_VL_MODEL=
EXTRACTION_SECOND_OPINION_MODEL=
EXTRACTION_CONFIDENCE_THRESHOLD=

# ---------- backend module: matching ----------
# (deterministic; no external services — module settings TBD)

# ---------- backend module: rules ----------
RULES_NEAR_LIMIT_THRESHOLD=

# ---------- backend module: assistant ----------
ASSISTANT_QWEN_API_KEY=
ASSISTANT_QWEN_MODEL=

# ---------- backend module: reports ----------
# (deterministic templating — module settings TBD)
